# ── Auth ──────────────────────────────────────────────────────────────────────
# Password for the Streamlit login gate. Leave blank to disable (dev mode).
APP_PASSWORD=your_access_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key from Supabase → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Azure Function (Repo A — email-backend-send) ───────────────────────────────
# Base URL of your deployed Azure Function App (no trailing slash)
FUNCTION_BASE=https://your-function-app.azurewebsites.net/api
# Function-level auth key (code= query param)
FUNCTION_KEY=your_function_key_here
